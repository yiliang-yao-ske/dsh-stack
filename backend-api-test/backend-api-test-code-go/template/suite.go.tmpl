func loadConfig(t *testing.T) testConfig {
	t.Helper()

	required := []string{"ACCOUNT_TEST_TENANT_ID", "ACCOUNT_TEST_TENANT_ADMIN_ACCOUNT_ID"}
	var missing []string
	for _, key := range required {
		if strings.TrimSpace(os.Getenv(key)) == "" {
			missing = append(missing, key)
		}
	}
	if len(missing) > 0 {
		t.Fatalf(`缺少必需的环境变量：
  %s

示例：
  export ACCOUNT_TEST_TENANT_ID=10001
  export ACCOUNT_TEST_TENANT_ADMIN_ACCOUNT_ID=10001
  export ACCOUNT_TEST_BASE_URL=http://127.0.0.1:8082/api/account`, strings.Join(missing, "\n  "))
	}

	cfg := testConfig{
		BaseURL:         strings.TrimRight(envOr("ACCOUNT_TEST_BASE_URL", defaultBaseURL), "/"),
		TenantID:        int64Env(t, "ACCOUNT_TEST_TENANT_ID"),
		TenantAdminID:   int64Env(t, "ACCOUNT_TEST_TENANT_ADMIN_ACCOUNT_ID"),
		DeptAdminID:     int64EnvOptional(t, "ACCOUNT_TEST_DEPT_ADMIN_ACCOUNT_ID"),
		PlatformAdminID: int64EnvOptional(t, "ACCOUNT_TEST_PLATFORM_ADMIN_ACCOUNT_ID"),
		GatewaySecret:   strings.TrimSpace(os.Getenv("ACCOUNT_TEST_GATEWAY_SECRET")),
		LogDir:          envOr("ACCOUNT_TEST_LOG_DIR", filepath.Join(packageDir(), "logs")),
		LogSecrets:      boolEnv("ACCOUNT_TEST_LOG_SECRETS"),
		RunID:           strings.TrimSpace(os.Getenv("ACCOUNT_TEST_RUN_ID")),
		Location:        loadLocation(t),
		Timeout:         durationEnv("ACCOUNT_TEST_TIMEOUT", defaultTimeout),
	}
	if parsed, err := url.Parse(cfg.BaseURL); err != nil || parsed.Scheme == "" || parsed.Host == "" {
		t.Fatalf("ACCOUNT_TEST_BASE_URL 不是合法的绝对 URL: %q", cfg.BaseURL)
	}
	if cfg.RunID == "" {
		cfg.RunID = time.Now().Format("20060102-150405")
	}
	return cfg
}

func envOr(key, fallback string) string {
	if value := strings.TrimSpace(os.Getenv(key)); value != "" {
		return value
	}
	return fallback
}

func int64Env(t *testing.T, key string) int64 {
	t.Helper()
	raw := strings.TrimSpace(os.Getenv(key))
	value, err := strconv.ParseInt(raw, 10, 64)
	if err != nil || value <= 0 {
		t.Fatalf("%s 必须是正整数，实际为 %q", key, raw)
	}
	return value
}

func int64EnvOptional(t *testing.T, key string) int64 {
	t.Helper()
	raw := strings.TrimSpace(os.Getenv(key))
	if raw == "" {
		return 0
	}
	value, err := strconv.ParseInt(raw, 10, 64)
	if err != nil || value <= 0 {
		t.Fatalf("%s 必须是正整数或留空，实际为 %q", key, raw)
	}
	return value
}

func boolEnv(key string) bool {
	switch strings.ToLower(strings.TrimSpace(os.Getenv(key))) {
	case "1", "true", "yes", "on":
		return true
	default:
		return false
	}
}

func durationEnv(key string, fallback time.Duration) time.Duration {
	raw := strings.TrimSpace(os.Getenv(key))
	if raw == "" {
		return fallback
	}
	value, err := time.ParseDuration(raw)
	if err != nil || value <= 0 {
		return fallback
	}
	return value
}

func loadLocation(t *testing.T) *time.Location {
	t.Helper()
	name := envOr("ACCOUNT_TEST_TIMEZONE", "Local")
	location, err := time.LoadLocation(name)
	if err != nil {
		t.Fatalf("ACCOUNT_TEST_TIMEZONE 非法: %q: %v", name, err)
	}
	return location
}

func packageDir() string {
	_, file, _, ok := runtime.Caller(0)
	if !ok {
		return "."
	}
	return filepath.Dir(file)
}

