func preflight(t *testing.T, client *apiClient, cfg testConfig) {
	t.Helper()
	check := func(label string, id identity) {
		response, err := client.send(http.MethodGet, "/auth/me", nil, nil, id, "preflight "+label)
		if err != nil {
			t.Fatalf("预检 %s 失败: %v（accountd 是否运行在 %s？）", label, err, cfg.BaseURL)
		}
		client.expectOK(t, response, "预检 "+label+" /auth/me")
		view := resultObject(t, response)
		account := view["account"]
		object, ok := account.(map[string]any)
		if !ok {
			t.Fatalf("预检 %s: /auth/me 缺少 account 对象", label)
		}
		if got, ok := int64Of(object["accountId"]); !ok || got != id.AccountID {
			t.Fatalf("预检 %s: accountId=%v，与配置的 %d 不一致", label, object["accountId"], id.AccountID)
		}
	}
	check("tenant-admin", identity{Name: "tenant-admin", AccountID: cfg.TenantAdminID, TenantID: cfg.TenantID})
	if cfg.DeptAdminID > 0 {
		check("dept-admin", identity{Name: "dept-admin", AccountID: cfg.DeptAdminID, TenantID: cfg.TenantID})
	}
}

func TestSuite(t *testing.T) {
	cfg := loadConfig(t)

	log := newRunLog(t, cfg.LogDir, cfg.LogSecrets, cfg.RunID, cfg.Location)
	// Registered first, so it runs last: the cleanup above must still be able
	// to write into the log.
	t.Cleanup(func() { log.Close(t.Failed()) })

	client := newAPIClient(cfg, log)
	tracker := &credentialTracker{}
	t.Cleanup(func() { tracker.cleanup(t, client, cfg) })

	log.Config(cfg)
	log.Section("预检")
	preflight(t, client, cfg)

	log.Section("用例执行")
	for _, testCase := range apiCases {
		testCase := testCase
		name := testCase.Kind + "/" + testCase.ID
		if testCase.Title != "" {
			name += " " + testCase.Title
		}
		t.Run(name, func(t *testing.T) {
			runCase(t, cfg, client, tracker, testCase)
		})
	}
}

func runCase(t *testing.T, cfg testConfig, client *apiClient, tracker *credentialTracker, testCase apiCase) {
	t.Helper()

	caller := mustIdentity(t, cfg, testCase.As)
	body := expandBody(testCase.Body, cfg)
	query := url.Values{}
	for key, value := range testCase.Query {
		query.Set(key, value)
	}

	label := testCase.ID
	if testCase.Title != "" {
		label += " " + testCase.Title
	}

	response, err := client.send(testCase.Method, testCase.Path, query, body, caller, label)
	if err != nil {
		t.Fatalf("%s: 请求失败: %v", label, err)
	}

	status := testCase.WantStatus
	if status == 0 {
		status = http.StatusOK
	}
	success := status < http.StatusBadRequest && testCase.WantCode == 0
	if success {
		client.expectOK(t, response, label)
	} else {
		client.expectError(t, response, status, testCase.WantCode, testCase.CheckCode, testCase.MessageContains, label)
	}

	if testCase.MessageNonEmpty {
		client.assertf(t, response.Seq, label+" message", response.Envelope.Message != "", "message 为空，期望非空")
	}

	if testCase.ResultAbsent {
		trimmed := bytes.TrimSpace(response.Envelope.Result)
		client.assertf(t, response.Seq, label+" result", len(trimmed) == 0 || bytes.Equal(trimmed, []byte("null")),
			"result 应为空，实际 %s", string(trimmed))
	}

	if len(testCase.Headers) > 0 {
		applyHeaders(t, client, response, testCase.Headers)
	}

	if !success {
		return
	}

	value := resultAny(t, response)
	object, ok := value.(map[string]any)
	if !ok {
		needsObject := len(testCase.Required) > 0 || len(testCase.Types) > 0 || len(testCase.Fields) > 0 ||
			testCase.Baseline != "" || testCase.VerifyTenant
		if !needsObject {
			return
		}
		t.Fatalf("%s: result 不是对象，实际为 %T", label, value)
	}

	applySchema(t, client, response, object, testCase.Required, testCase.Types)
	applyFields(t, client, response, object, body, testCase.Fields, cfg)

	switch testCase.Baseline {
	case "":
	case "create":
		applyCreateBaseline(t, client, response, object)
	default:
		client.assertf(t, response.Seq, label+" baseline", false, "未知 baseline %q", testCase.Baseline)
	}

	if value, ok := lookup(object, "credentialId"); ok {
		if id, ok := int64Of(value); ok && id > 0 {
			tracker.add(scopeOfPath(testCase.Path), id, testCase.ID)
		}
	}

	if testCase.VerifyTenant {
		verifyTenant(t, client, cfg, caller, testCase, object)
	}
}

