	defaultBaseURL     = "http://127.0.0.1:8082/api/account"
	defaultTimeout     = 30 * time.Second
	tenantRevokePath   = "/tenant/mcp-credentials/revoke"
	platformRevokePath = "/platform/mcp-credentials/revoke"
	scopeTenant        = "tenant"
	scopePlatform      = "platform"
	// approxTolerance is how far an expireTime may sit from the expected day.
	approxTolerance = 5 * time.Minute
