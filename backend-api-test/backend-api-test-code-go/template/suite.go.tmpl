// never share files or symbols.
//
// Environment variables:
//
//	ACCOUNT_TEST_BASE_URL                  default http://127.0.0.1:8082/api/account
//	ACCOUNT_TEST_TENANT_ID                 required, positive integer
//	ACCOUNT_TEST_TENANT_ADMIN_ACCOUNT_ID   required, positive integer
//	ACCOUNT_TEST_DEPT_ADMIN_ACCOUNT_ID     optional; auth cases skip when unset
//	ACCOUNT_TEST_PLATFORM_ADMIN_ACCOUNT_ID optional; cleanup of platform credentials
//	ACCOUNT_TEST_GATEWAY_SECRET            optional
//	ACCOUNT_TEST_RUN_ID                    optional, defaults to a timestamp
//	ACCOUNT_TEST_TIMEOUT                   optional, Go duration, default 30s
//	ACCOUNT_TEST_TIMEZONE                  optional, default Local
//	ACCOUNT_TEST_LOG_DIR                   optional, default <package dir>/logs
//	ACCOUNT_TEST_LOG_SECRETS               optional, "1" to keep secrets in the log
//
// Request body strings are expanded before the request:
//
//	$unique       unique per run and per call
//	$unique:N     unique text of exactly N characters
