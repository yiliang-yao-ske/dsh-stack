type identity struct {
	Name      string
	AccountID int64
	TenantID  int64
}

func mustIdentity(t *testing.T, cfg testConfig, name string) identity {
	t.Helper()
	switch name {
	case "tenant_admin":
		return identity{Name: "tenant-admin", AccountID: cfg.TenantAdminID, TenantID: cfg.TenantID}
	case "dept_admin":
		if cfg.DeptAdminID == 0 {
			t.Skipf("用例需要 dept_admin，但 ACCOUNT_TEST_DEPT_ADMIN_ACCOUNT_ID 未设置")
		}
		return identity{Name: "dept-admin", AccountID: cfg.DeptAdminID, TenantID: cfg.TenantID}
	case "anonymous":
		return identity{Name: "anonymous"}
	default:
		t.Fatalf("未知身份 %q：用例 yml 的 as 只能是 tenant_admin/dept_admin/anonymous", name)
		return identity{}
	}
}

// ---------------------------------------------------------------------------
// Run log
// ---------------------------------------------------------------------------

var (
	tokenPattern       = regexp.MustCompile(`kmcp_[A-Za-z0-9_-]{8,}`)
	tokenSecretPattern = regexp.MustCompile(`^[A-Za-z0-9_-]{43}$`)
	runIDPattern       = regexp.MustCompile(`[^A-Za-z0-9._-]+`)
	sensitiveKeys      = map[string]bool{
		"secret": true, "token": true, "secrethash": true, "password": true,
		"accesstoken": true, "refreshtoken": true, "gatewaysecret": true,
	}
)

type runLog struct {
	mu        sync.Mutex
	file      *os.File
	path      string
	secrets   bool
	location  *time.Location
	start     time.Time
	pass      int
	fail      int
	closeOnce sync.Once
}

func newRunLog(t *testing.T, dir string, secrets bool, runID string, location *time.Location) *runLog {
	t.Helper()
	if err := os.MkdirAll(dir, 0o755); err != nil {
		t.Fatalf("创建日志目录 %s 失败: %v", dir, err)
	}
	runID = sanitizeRunID(runID)
	suite := filepath.Base(packageDir())
	if suite == "" || suite == "." || suite == string(filepath.Separator) {
		suite = "suite"
	}
	base := suite + "-" + time.Now().In(location).Format("20060102-150405")
	if runID != "" {
		base = suite + "-" + runID
	}
	for attempt := 0; attempt < 100; attempt++ {
		suffix := ""
		if attempt > 0 {
			suffix = fmt.Sprintf("-%02d", attempt)
		}
		file, err := os.OpenFile(filepath.Join(dir, base+suffix+".log"), os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o644)
		if err == nil {
			if location == nil {
				location = time.Local
			}
			return &runLog{
				file: file, path: file.Name(), secrets: secrets,
				location: location, start: time.Now(),
			}
		}
		if !os.IsExist(err) {
			t.Fatalf("创建日志文件失败: %v", err)
		}
	}
	t.Fatalf("无法在 %s 下创建唯一日志文件", dir)
	return nil
}

func (l *runLog) Path() string { return l.path }

// now is safe to call while l.mu is held or not: it only reads location.
func (l *runLog) now() string {
	return time.Now().In(l.location).Format("15:04:05.000")
}

func (l *runLog) Section(title string) {
	l.mu.Lock()
	defer l.mu.Unlock()
	fmt.Fprintf(l.file, "\n[%s] ===== %s =====\n", l.now(), title)
}

// Config records the run environment. Secrets are recorded as a boolean only.
func (l *runLog) Config(cfg testConfig) {
	l.Section("运行配置")
	l.mu.Lock()
	defer l.mu.Unlock()
	fmt.Fprintf(l.file, "  base_url=%s\n", cfg.BaseURL)
	fmt.Fprintf(l.file, "  tenant_id=%d tenant_admin=%d dept_admin=%d platform_admin=%d\n",
		cfg.TenantID, cfg.TenantAdminID, cfg.DeptAdminID, cfg.PlatformAdminID)
	fmt.Fprintf(l.file, "  run_id=%s timezone=%s timeout=%s\n", cfg.RunID, cfg.Location, cfg.Timeout)
	fmt.Fprintf(l.file, "  gateway_secret=%t log_secrets=%t\n", cfg.GatewaySecret != "", cfg.LogSecrets)
}

func (l *runLog) Request(seq int, label string, id identity, method, rawURL string, headers http.Header, body []byte) {
	l.mu.Lock()
	defer l.mu.Unlock()
	fmt.Fprintf(l.file, "\n[%s] #%d REQUEST %s\n", l.now(), seq, label)
	fmt.Fprintf(l.file, "  identity: %s (account=%d tenant=%d)\n", id.Name, id.AccountID, id.TenantID)
	fmt.Fprintf(l.file, "  %s %s\n", method, rawURL)
	l.writeHeadersLocked(headers)
	fmt.Fprintf(l.file, "  body:\n%s\n", l.formatBodyLocked(body))
}

func (l *runLog) Response(seq int, label string, status int, duration time.Duration, headers http.Header, body []byte) {
	l.mu.Lock()
	defer l.mu.Unlock()
	fmt.Fprintf(l.file, "[%s] #%d RESPONSE %s: HTTP %d (%s)\n",
		l.now(), seq, label, status, duration.Round(time.Millisecond))
	l.writeHeadersLocked(headers)
	fmt.Fprintf(l.file, "  body:\n%s\n", l.formatBodyLocked(body))
}

func (l *runLog) TransportError(seq int, label string, err error, duration time.Duration) {
	l.mu.Lock()
	defer l.mu.Unlock()
	fmt.Fprintf(l.file, "[%s] #%d TRANSPORT ERROR %s after %s: %v\n",
		l.now(), seq, label, duration.Round(time.Millisecond), err)
}

func (l *runLog) Assert(seq int, name string, ok bool, detail string) {
	l.mu.Lock()
	defer l.mu.Unlock()
	if !l.secrets {
		detail = tokenPattern.ReplaceAllString(detail, "kmcp_***")
	}
	status := "PASS"
	if ok {
		l.pass++
	} else {
		l.fail++
		status = "FAIL"
	}
	fmt.Fprintf(l.file, "[%s] #%d ASSERT %s %s: %s\n", l.now(), seq, status, name, detail)
}

func (l *runLog) Close(failed bool) {
	l.closeOnce.Do(func() {
		l.mu.Lock()
		defer l.mu.Unlock()
		fmt.Fprintln(l.file, "\n================================================================================")
		fmt.Fprintf(l.file, "SUMMARY: pass=%d fail=%d test_failed=%t duration=%s\n",
			l.pass, l.fail, failed, time.Since(l.start).Round(time.Millisecond))
		fmt.Fprintf(l.file, "log: %s\n", l.path)
		fmt.Fprintln(l.file, "================================================================================")
		_ = l.file.Close()
	})
}

func (l *runLog) writeHeadersLocked(headers http.Header) {
	keys := make([]string, 0, len(headers))
	for key := range headers {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	fmt.Fprintln(l.file, "  headers:")
	for _, key := range keys {
		values := headers.Values(key)
		if !l.secrets && isSensitiveHeader(key) {
			values = []string{"***"}
		}
		fmt.Fprintf(l.file, "    %s: %s\n", key, strings.Join(values, ", "))
	}
}

func isSensitiveHeader(key string) bool {
	switch strings.ToLower(key) {
	case "authorization", "cookie", "set-cookie", "x-gateway-secret", "x-internal-key":
		return true
	default:
		return false
	}
}

func (l *runLog) formatBodyLocked(body []byte) string {
	if len(body) == 0 {
		return "  (empty)"
	}
	var value any
	decoder := json.NewDecoder(bytes.NewReader(body))
	decoder.UseNumber()
	if err := decoder.Decode(&value); err != nil {
		return "  " + string(body)
	}
	if !l.secrets {
		value = sanitize(value)
	}
	encoded, err := json.MarshalIndent(value, "  ", "  ")
	if err != nil {
		return "  " + string(body)
	}
	return "  " + strings.ReplaceAll(string(encoded), "\n", "\n  ")
}

func sanitize(value any) any {
	switch node := value.(type) {
	case map[string]any:
		out := make(map[string]any, len(node))
		for key, item := range node {
			if strings.EqualFold(key, "tokenPrefix") {
				out[key] = item
				continue
			}
			if sensitiveKeys[strings.ToLower(key)] {
				out[key] = "***"
				continue
			}
			out[key] = sanitize(item)
		}
		return out
	case []any:
		out := make([]any, len(node))
		for index, item := range node {
			out[index] = sanitize(item)
		}
		return out
	case string:
		return tokenPattern.ReplaceAllString(node, "kmcp_***")
	default:
		return value
	}
}

func sanitizeRunID(value string) string {
	value = strings.TrimSpace(value)
	value = runIDPattern.ReplaceAllString(value, "-")
	value = strings.Trim(value, "-.")
	if len(value) > 64 {
		value = value[:64]
	}
	return value
}

// ---------------------------------------------------------------------------
// HTTP client
// ---------------------------------------------------------------------------

type envelope struct {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Result  json.RawMessage `json:"result"`
}

type apiResponse struct {
	Seq       int
	Label     string
	Status    int
	Header    http.Header
	Body      []byte
	Duration  time.Duration
	Envelope  envelope
	DecodeErr error
}

type apiClient struct {
	cfg  testConfig
	http *http.Client
	log  *runLog
	mu   sync.Mutex
	seq  int
}

func newAPIClient(cfg testConfig, log *runLog) *apiClient {
	return &apiClient{cfg: cfg, http: &http.Client{Timeout: cfg.Timeout}, log: log}
}

func (c *apiClient) nextSeq() int {
	c.mu.Lock()
	defer c.mu.Unlock()
	c.seq++
	return c.seq
}

func (c *apiClient) identityHeaders(id identity, seq int) http.Header {
	headers := http.Header{}
	headers.Set("Accept", "application/json")
	headers.Set("X-Request-Id", fmt.Sprintf("e2e-%d-%d", time.Now().UnixNano(), seq))
	if id.AccountID > 0 {
		account := strconv.FormatInt(id.AccountID, 10)
		headers.Set("X-Forwarded-User", account)
		if c.cfg.GatewaySecret != "" {
			headers.Set("X-Gateway-Secret", c.cfg.GatewaySecret)
			headers.Set("X-User-Id", account)
		}
	}
	if id.TenantID > 0 {
		headers.Set("X-Tenant-Id", strconv.FormatInt(id.TenantID, 10))
	}
	return headers
}

func (c *apiClient) send(method, path string, query url.Values, body any, id identity, label string) (*apiResponse, error) {
	seq := c.nextSeq()
	rawURL := c.cfg.BaseURL + path
	if len(query) > 0 {
		rawURL += "?" + query.Encode()
	}

	var payload []byte
	if body != nil {
		encoded, err := json.Marshal(body)
		if err != nil {
			return nil, fmt.Errorf("编码请求体: %w", err)
		}
		payload = encoded
	}

	request, err := http.NewRequest(method, rawURL, bytes.NewReader(payload))
	if err != nil {
		return nil, fmt.Errorf("构造请求: %w", err)
	}
	headers := c.identityHeaders(id, seq)
	if body != nil {
		headers.Set("Content-Type", "application/json")
	}
	request.Header = headers

	c.log.Request(seq, label, id, method, rawURL, headers, payload)

	started := time.Now()
	response, err := c.http.Do(request)
	if err != nil {
		c.log.TransportError(seq, label, err, time.Since(started))
		return nil, fmt.Errorf("%s %s: %w", method, rawURL, err)
	}
	defer response.Body.Close()

	data, readErr := io.ReadAll(io.LimitReader(response.Body, 8<<20))
	duration := time.Since(started)
	c.log.Response(seq, label, response.StatusCode, duration, response.Header, data)
	if readErr != nil {
		return nil, fmt.Errorf("读取响应: %w", readErr)
	}

	out := &apiResponse{
		Seq: seq, Label: label, Status: response.StatusCode, Header: response.Header,
		Body: data, Duration: duration,
	}
	if err := json.Unmarshal(data, &out.Envelope); err != nil {
		out.DecodeErr = err
	}
	return out, nil
}

func (c *apiClient) expectOK(t *testing.T, response *apiResponse, label string) {
	t.Helper()
	ok := response.Status == http.StatusOK && response.Envelope.Code == 0 && response.DecodeErr == nil
	detail := fmt.Sprintf("HTTP %d, code=%d, message=%q", response.Status, response.Envelope.Code, response.Envelope.Message)
	if response.DecodeErr != nil {
		detail += ", decode=" + response.DecodeErr.Error()
	}
	c.log.Assert(response.Seq, label, ok, detail)
	if !ok {
		t.Fatalf("%s: 期望成功（HTTP 200 + code 0），实际 %s", label, detail)
	}
}

// expectError checks a non-success response. checkCode is false when the case
// has no explicit "code" key, so a gateway 401 without a JSON envelope can
// still be asserted. messageContains is skipped when empty; gen.mjs rejects
// code != 0 cases without a message assertion unless they opt out explicitly.
func (c *apiClient) expectError(t *testing.T, response *apiResponse, status, code int, checkCode bool, messageContains, label string) {
	t.Helper()
	ok := response.Status == status
	detail := fmt.Sprintf("HTTP %d, code=%d, message=%q", response.Status, response.Envelope.Code, response.Envelope.Message)
	if checkCode {
		if response.DecodeErr != nil {
			ok = false
			detail += ", decode=" + response.DecodeErr.Error()
		} else {
			ok = ok && response.Envelope.Code == code
		}
	}
	if messageContains != "" {
		ok = ok && strings.Contains(response.Envelope.Message, messageContains)
	}
	c.log.Assert(response.Seq, label, ok, detail)
	if !ok {
		t.Errorf("%s: 期望 HTTP %d/code %d/包含 %q，实际 %s", label, status, code, messageContains, detail)
	}
}

// assertf records every assertion in the run log, so SUMMARY pass/fail counts
// match the test result. The apply* helpers use it instead of t.Errorf.
func (c *apiClient) assertf(t *testing.T, seq int, name string, ok bool, format string, args ...any) {
	t.Helper()
	detail := fmt.Sprintf(format, args...)
	c.log.Assert(seq, name, ok, detail)
	if !ok {
		t.Errorf("%s: %s", name, detail)
	}
}

// ---------------------------------------------------------------------------
// Result helpers
// ---------------------------------------------------------------------------

func resultAny(t *testing.T, response *apiResponse) any {
	t.Helper()
	if response.DecodeErr != nil {
		t.Fatalf("%s: 响应不是合法 JSON: %v", response.Label, response.DecodeErr)
	}
	trimmed := bytes.TrimSpace(response.Envelope.Result)
	if len(trimmed) == 0 || bytes.Equal(trimmed, []byte("null")) {
		return nil
	}
	decoder := json.NewDecoder(bytes.NewReader(trimmed))
	decoder.UseNumber()
	var value any
	if err := decoder.Decode(&value); err != nil {
		t.Fatalf("%s: 解析 result 失败: %v", response.Label, err)
	}
	return value
}

func resultObject(t *testing.T, response *apiResponse) map[string]any {
	t.Helper()
	value := resultAny(t, response)
	if value == nil {
		t.Fatalf("%s: result 为空，期望对象", response.Label)
	}
	object, ok := value.(map[string]any)
	if !ok {
		t.Fatalf("%s: result 不是对象，实际为 %T", response.Label, value)
	}
	return object
}

func lookup(root map[string]any, path string) (any, bool) {
	if root == nil {
		return nil, false
	}
	var current any = root
	for _, part := range strings.Split(path, ".") {
		object, ok := current.(map[string]any)
		if !ok {
			return nil, false
		}
		current, ok = object[part]
		if !ok {
			return nil, false
		}
	}
	return current, true
}

func int64Of(value any) (int64, bool) {
	switch number := value.(type) {
	case json.Number:
		parsed, err := number.Int64()
		return parsed, err == nil
	case float64:
		// A JSON number decoded without UseNumber must still be an integer.
		if number != float64(int64(number)) {
			return 0, false
		}
		return int64(number), true
	case int:
		return int64(number), true
	case int64:
		return number, true
	default:
		return 0, false
	}
}

func stringSliceOf(value any) ([]string, bool) {
	items, ok := value.([]any)
	if !ok {
		return nil, false
	}
	out := make([]string, 0, len(items))
	for _, item := range items {
		text, ok := item.(string)
		if !ok {
			return nil, false
		}
		out = append(out, text)
	}
	return out, true
}

func typeMatches(value any, want string) bool {
	switch want {
	case "string":
		_, ok := value.(string)
		return ok
	case "int64":
		_, ok := int64Of(value)
		return ok
	case "bool":
		_, ok := value.(bool)
		return ok
	case "string_array":
		_, ok := stringSliceOf(value)
		return ok
	default:
		return false
	}
}

func describe(value any) string {
	raw, err := json.Marshal(sanitize(value))
	if err != nil {
		return fmt.Sprintf("%v", value)
	}
	return tokenPattern.ReplaceAllString(string(raw), "kmcp_***")
}

func sameSet(got, want []string) bool {
	if len(got) != len(want) {
		return false
	}
	left := append([]string(nil), got...)
	right := append([]string(nil), want...)
	sort.Strings(left)
	sort.Strings(right)
	for index := range left {
		if left[index] != right[index] {
			return false
		}
	}
	return true
}

// ---------------------------------------------------------------------------
// Assertions driven by the generated table
// ---------------------------------------------------------------------------

type fieldExpect struct {
	Path        string
	Type        string
	Equals      *string
	EqualsRef   string
	Prefix      string
	Contains    string
	ContainsAll []string
	EqualsSet   []string
	NonEmpty    bool
	Absent      bool
	// AllowNull, with Absent, accepts a JSON null as "not returned". Without
	// it, Absent rejects both a value and an explicit null.
	AllowNull  bool
	GT         *float64
	TokenJoin  bool
	ApproxDays *int
}

type headerExpect struct {
	Name     string
	Equals   string
	Contains string
}

type apiCase struct {
	Kind   string
	ID     string
	Title  string
	As     string
	Method string
	Path   string
	Query  map[string]string
	Body   map[string]any
	// Baseline is a cross-cutting assertion preset. "create" asserts that a
	// credentialId, a token/tokenPrefix/secret triplet and scopes came back.
	Baseline        string
	WantStatus      int
	WantCode        int
	CheckCode       bool
	MessageContains string
	MessageNonEmpty bool
	ResultAbsent    bool
	Required        []string
	Types           map[string]string
	Fields          []fieldExpect
	Headers         []headerExpect
	// VerifyTenant follows a successful create with a detail request and
	// checks that the new record belongs to cfg.TenantID.
	VerifyTenant bool
}

func strptr(value string) *string { return &value }

func f64ptr(value float64) *float64 { return &value }

func intptr(value int) *int { return &value }

func applyFields(t *testing.T, client *apiClient, response *apiResponse, result, body map[string]any, fields []fieldExpect, cfg testConfig) {
	t.Helper()
	for _, field := range fields {
		applyField(t, client, response, result, body, field, cfg)
	}
}

func applyField(t *testing.T, client *apiClient, response *apiResponse, result, body map[string]any, field fieldExpect, cfg testConfig) {
	t.Helper()
	name := response.Label + " " + field.Path

	if field.Absent {
		value, ok := lookup(result, field.Path)
		present := ok && (value != nil || !field.AllowNull)
		client.assertf(t, response.Seq, name, !present, "字段不应出现，实际 %s", describe(value))
		return
	}

	value, ok := lookup(result, field.Path)
	if !ok {
		client.assertf(t, response.Seq, name, false, "字段缺失")
		return
	}
	client.assertf(t, response.Seq, name, true, "字段存在")

	if field.TokenJoin {
		err := checkTokenJoin(result, field.Path)
		client.assertf(t, response.Seq, name, err == nil, "token 组合不成立: %v", err)
		return
	}

	switch field.Type {
	case "int64":
		number, ok := int64Of(value)
		client.assertf(t, response.Seq, name, ok, "不是整数，实际为 %T (%s)", value, describe(value))
		if !ok {
			return
		}
		if field.GT != nil {
			client.assertf(t, response.Seq, name, float64(number) > *field.GT, "= %d，期望 > %v", number, *field.GT)
		}
		if field.Equals != nil {
			client.assertf(t, response.Seq, name, strconv.FormatInt(number, 10) == *field.Equals, "= %d，期望 %q", number, *field.Equals)
		}
		if field.EqualsRef != "" {
			reference, resolved := resolveRef(field.EqualsRef, result, body, cfg)
			client.assertf(t, response.Seq, name, resolved && strconv.FormatInt(number, 10) == reference,
				"引用 %q 解析为 %q，实际 %d", field.EqualsRef, reference, number)
		}
	case "string":
		text, ok := value.(string)
		client.assertf(t, response.Seq, name, ok, "不是字符串，实际为 %T", value)
		if !ok {
			return
		}
		if field.Equals != nil {
			client.assertf(t, response.Seq, name, text == *field.Equals, "= %q，期望 %q", text, *field.Equals)
		}
		if field.EqualsRef != "" {
			reference, resolved := resolveRef(field.EqualsRef, result, body, cfg)
			client.assertf(t, response.Seq, name, resolved && text == reference,
				"引用 %q 解析为 %q，实际 %q", field.EqualsRef, reference, text)
		}
		if field.Prefix != "" {
			client.assertf(t, response.Seq, name, strings.HasPrefix(text, field.Prefix), "= %q，期望前缀 %q", text, field.Prefix)
		}
		if field.Contains != "" {
			client.assertf(t, response.Seq, name, strings.Contains(text, field.Contains), "= %q，不含 %q", text, field.Contains)
		}
		for _, needle := range field.ContainsAll {
			client.assertf(t, response.Seq, name, strings.Contains(text, needle), "= %q，不含 %q", text, needle)
		}
		if field.NonEmpty {
			client.assertf(t, response.Seq, name, text != "", "为空，期望非空")
		}
		if field.ApproxDays != nil {
			err := checkApproxDays(text, *field.ApproxDays, cfg.Location)
			client.assertf(t, response.Seq, name, err == nil, "= %q，%v", text, err)
		}
	case "string_array":
		items, ok := stringSliceOf(value)
		client.assertf(t, response.Seq, name, ok, "不是字符串数组，实际 %s", describe(value))
		if !ok {
			return
		}
		if field.EqualsSet != nil {
			client.assertf(t, response.Seq, name, sameSet(items, field.EqualsSet), "= %v，期望集合 %v", items, field.EqualsSet)
		}
	case "bool":
		_, ok := value.(bool)
		client.assertf(t, response.Seq, name, ok, "不是布尔值，实际为 %T", value)
	default:
		client.assertf(t, response.Seq, name, false, "type=%q 不受支持", field.Type)
	}
}

// applyCreateBaseline asserts the response contract shared by every successful
// credential create, independently of the parameter under test.
func applyCreateBaseline(t *testing.T, client *apiClient, response *apiResponse, result map[string]any) {
	t.Helper()
	name := response.Label + " baseline"

	idValue, ok := lookup(result, "credentialId")
	id, idOK := int64Of(idValue)
	client.assertf(t, response.Seq, name+" credentialId", ok && idOK && id > 0, "credentialId=%v", idValue)

	nameValue, ok := lookup(result, "name")
	text, textOK := nameValue.(string)
	client.assertf(t, response.Seq, name+" name", ok && textOK && text != "", "name=%v", nameValue)

	scopesValue, ok := lookup(result, "scopes")
	scopes, scopesOK := stringSliceOf(scopesValue)
	client.assertf(t, response.Seq, name+" scopes", ok && scopesOK && len(scopes) > 0, "scopes=%v", scopesValue)

	tokenValue, ok := lookup(result, "token")
	token, tokenOK := tokenValue.(string)
	client.assertf(t, response.Seq, name+" token", ok && tokenOK && token != "", "token 长度=%d", len(token))

	prefixValue, ok := lookup(result, "tokenPrefix")
	prefix, prefixOK := prefixValue.(string)
	client.assertf(t, response.Seq, name+" tokenPrefix", ok && prefixOK && strings.HasPrefix(prefix, "kmcp_"), "tokenPrefix=%v", prefixValue)

	joinErr := checkTokenJoin(result, "token")
	client.assertf(t, response.Seq, name+" token 组合", joinErr == nil, "token 组合校验: %v", joinErr)
}

// verifyTenant performs one follow-up detail request after a successful
// create. The create response does not carry tenantId, so ownership must be
// checked through detail.
func verifyTenant(t *testing.T, client *apiClient, cfg testConfig, caller identity, testCase apiCase, result map[string]any) {
	t.Helper()
	label := testCase.ID + " 归属复核"

	value, ok := lookup(result, "credentialId")
	id, idOK := int64Of(value)
	if !ok || !idOK || id <= 0 {
		client.assertf(t, 0, label, false, "缺少 credentialId，无法复核归属")
		return
	}

	path := strings.TrimSuffix(testCase.Path, "/") + "/detail"
	query := url.Values{"credentialId": {strconv.FormatInt(id, 10)}}
	response, err := client.send(http.MethodGet, path, query, nil, caller, label)
	if err != nil {
		t.Fatalf("%s: 请求失败: %v", label, err)
	}
	client.expectOK(t, response, label)
	detail := resultObject(t, response)
	tenantValue, ok := lookup(detail, "tenantId")
	tenantID, tenantOK := int64Of(tenantValue)
	client.assertf(t, response.Seq, label+" tenantId", ok && tenantOK && tenantID == cfg.TenantID,
		"tenantId=%v，期望 %d", tenantValue, cfg.TenantID)
}

func resolveRef(reference string, result, body map[string]any, cfg testConfig) (string, bool) {
	if reference == "$config.tenant_id" {
		return strconv.FormatInt(cfg.TenantID, 10), true
	}
	if strings.HasPrefix(reference, "$request.body.") {
		value, ok := lookup(body, strings.TrimPrefix(reference, "$request.body."))
		if !ok {
			return "", false
		}
		text, ok := value.(string)
		return text, ok
	}
	if strings.HasPrefix(reference, "$response.") {
		value, ok := lookup(result, strings.TrimPrefix(reference, "$response."))
		if !ok {
			return "", false
		}
		text, ok := value.(string)
		return text, ok
	}
	return "", false
}

func checkTokenJoin(result map[string]any, tokenPath string) error {
	prefix, ok := lookup(result, "tokenPrefix")
	if !ok {
		return fmt.Errorf("缺少 tokenPrefix")
	}
	secret, ok := lookup(result, "secret")
	if !ok {
		return fmt.Errorf("缺少 secret")
	}
	token, ok := lookup(result, tokenPath)
	if !ok {
		return fmt.Errorf("缺少 %s", tokenPath)
	}
	prefixText, ok1 := prefix.(string)
	secretText, ok2 := secret.(string)
	tokenText, ok3 := token.(string)
	if !ok1 || !ok2 || !ok3 {
		return fmt.Errorf("tokenPrefix/secret/%s 必须是字符串", tokenPath)
	}
	if tokenText != prefixText+"_"+secretText {
		return fmt.Errorf("token 不等于 tokenPrefix+\"_\"+secret（token 长度 %d）", len(tokenText))
	}
	if len(secretText) != 43 {
		return fmt.Errorf("secret 长度 = %d，期望 43", len(secretText))
	}
	if !tokenSecretPattern.MatchString(secretText) {
		return fmt.Errorf("secret 含非法字符")
	}
	return nil
}

func applySchema(t *testing.T, client *apiClient, response *apiResponse, result map[string]any, required []string, types map[string]string) {
	t.Helper()
	for _, path := range required {
		value, ok := lookup(result, path)
		client.assertf(t, response.Seq, response.Label+" "+path, ok && value != nil, "响应缺少必需字段 %q", path)
	}
	paths := make([]string, 0, len(types))
	for path := range types {
		paths = append(paths, path)
	}
	sort.Strings(paths)
	for _, path := range paths {
		value, ok := lookup(result, path)
		if !ok {
			client.assertf(t, response.Seq, response.Label+" "+path, false, "响应缺少字段 %q", path)
			continue
		}
		client.assertf(t, response.Seq, response.Label+" "+path, typeMatches(value, types[path]),
			"字段类型应为 %s，实际为 %T", types[path], value)
	}
}

func applyHeaders(t *testing.T, client *apiClient, response *apiResponse, headers []headerExpect) {
	t.Helper()
	for _, expect := range headers {
		got := response.Header.Get(expect.Name)
		if expect.Equals != "" {
			client.assertf(t, response.Seq, response.Label+" header "+expect.Name, got == expect.Equals,
				"= %q，期望 %q", got, expect.Equals)
		}
		if expect.Contains != "" {
			client.assertf(t, response.Seq, response.Label+" header "+expect.Name, strings.Contains(got, expect.Contains),
				"= %q，不含 %q", got, expect.Contains)
		}
	}
}

func checkApproxDays(value string, days int, location *time.Location) error {
	expire, err := parseServiceTime(value, location)
	if err != nil {
		return err
	}
	want := time.Now().AddDate(0, 0, days)
	if expire.Before(want.Add(-approxTolerance)) || expire.After(want.Add(approxTolerance)) {
		return fmt.Errorf("时间与 now+%dd 相差超过 %s", days, approxTolerance)
	}
	return nil
}

func parseServiceTime(value string, location *time.Location) (time.Time, error) {
	layouts := []string{"2006-01-02T15:04:05.999999999", "2006-01-02T15:04:05", "2006-01-02T15:04"}
	for _, layout := range layouts {
		if parsed, err := time.ParseInLocation(layout, value, location); err == nil {
			return parsed, nil
		}
	}
	return time.Time{}, fmt.Errorf("无法按服务的时间格式解析 %q", value)
}

// ---------------------------------------------------------------------------
// Body expansion
// ---------------------------------------------------------------------------

var uniqueSeq int64

// uniqueText builds a value that is unique across calls and across processes.
// width <= 0 returns the natural length; a positive width pads with "x" or
// keeps the trailing (most unique) characters.
func uniqueText(runID string, width int) string {
	base := fmt.Sprintf("%s-%d-%d", runID, time.Now().UnixNano(), atomic.AddInt64(&uniqueSeq, 1))
	if width <= 0 || len(base) == width {
		return base
	}
	if len(base) > width {
		return base[len(base)-width:]
	}
	return base + strings.Repeat("x", width-len(base))
}

func expandBody(body map[string]any, cfg testConfig) map[string]any {
	if body == nil {
		return nil
	}
	out := make(map[string]any, len(body))
	for key, value := range body {
		out[key] = expandValue(value, cfg)
	}
	return out
}

func expandValue(value any, cfg testConfig) any {
	switch node := value.(type) {
	case string:
		switch {
		case node == "$unique":
			return uniqueText(cfg.RunID, 0)
		case strings.HasPrefix(node, "$unique:"):
			width, err := strconv.Atoi(strings.TrimPrefix(node, "$unique:"))
			if err != nil || width <= 0 {
				return node
			}
			return uniqueText(cfg.RunID, width)
		case strings.HasPrefix(node, "$repeat:"):
			count, err := strconv.Atoi(strings.TrimPrefix(node, "$repeat:"))
			if err != nil || count < 0 {
				return node
			}
			return strings.Repeat("x", count)
		case strings.HasPrefix(node, "$env."):
			return os.Getenv(strings.TrimPrefix(node, "$env."))
		default:
			// $unique is also valid inside a larger string, e.g. "case-$unique".
			text := strings.ReplaceAll(node, "${RUN_ID}", cfg.RunID)
			return strings.ReplaceAll(text, "$unique", uniqueText(cfg.RunID, 0))
		}
	case []any:
		out := make([]any, len(node))
		for index, item := range node {
			out[index] = expandValue(item, cfg)
		}
		return out
	case map[string]any:
		return expandBody(node, cfg)
	default:
		return value
	}
}

// ---------------------------------------------------------------------------
// Cleanup
// ---------------------------------------------------------------------------

type trackedCredential struct {
	Scope string
	ID    int64
	Name  string
}

type credentialTracker struct {
	mu    sync.Mutex
	items []trackedCredential
}

func (tracker *credentialTracker) add(scope string, id int64, name string) {
	tracker.mu.Lock()
	defer tracker.mu.Unlock()
	tracker.items = append(tracker.items, trackedCredential{Scope: scope, ID: id, Name: name})
}

// cleanup revokes every credential the run created. It is best-effort: a
// failed cleanup is logged, never turned into a test failure.
func (tracker *credentialTracker) cleanup(t *testing.T, client *apiClient, cfg testConfig) {
	tracker.mu.Lock()
	items := append([]trackedCredential(nil), tracker.items...)
	tracker.mu.Unlock()
	if len(items) == 0 {
		return
	}

	client.log.Section("清理：撤销本次运行创建的凭证")
	for index := len(items) - 1; index >= 0; index-- {
		item := items[index]
		caller := identity{Name: "tenant-admin (cleanup)", AccountID: cfg.TenantAdminID, TenantID: cfg.TenantID}
		path := tenantRevokePath
		if item.Scope == scopePlatform {
			if cfg.PlatformAdminID == 0 {
				t.Logf("跳过清理 platform 凭证 #%d：ACCOUNT_TEST_PLATFORM_ADMIN_ACCOUNT_ID 未设置", item.ID)
				continue
			}
			caller = identity{Name: "platform-admin (cleanup)", AccountID: cfg.PlatformAdminID}
			path = platformRevokePath
		}
		response, err := client.send(http.MethodPost, path, nil,
			map[string]any{"credentialId": item.ID, "reason": "测试清理"},
			caller, fmt.Sprintf("cleanup %s #%d", item.Name, item.ID))
		if err != nil {
			t.Logf("清理 %s #%d 失败: %v", item.Name, item.ID, err)
			continue
		}
		alreadyGone := response.Envelope.Code == 1 &&
			(strings.Contains(response.Envelope.Message, "已撤销") || strings.Contains(response.Envelope.Message, "不存在"))
		if response.Status == http.StatusOK && (response.Envelope.Code == 0 || alreadyGone) {
			t.Logf("清理 %s #%d: OK", item.Name, item.ID)
			continue
		}
		t.Logf("清理 %s #%d 未成功: HTTP %d code=%d message=%q",
			item.Name, item.ID, response.Status, response.Envelope.Code, response.Envelope.Message)
	}
}

func scopeOfPath(path string) string {
	if strings.HasPrefix(path, "/platform/") {
		return scopePlatform
	}
	return scopeTenant
}

